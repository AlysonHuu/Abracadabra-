# .env (Fichier partagé sur Git - NE METTRE AUCUN VRAI MOT DE PASSE ICI)
APP_ENV=dev
APP_SECRET=UnSecretSuperSecurisePourLeDev12345
APP_SHARE_DIR=var/share

# --- BASE DE DONNÉES ---
DEFAULT_URI=http://localhost
DATABASE_URL="mysql://abracadabra_user:abracadabra_password@abracadabra_db:3306/abracadabra"

# --- MESSENGER & MAILER ---
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null

# --- STRIPE (Variables vides pour l'exemple) ---



# --- GOOGLE OAUTH (Variables vides pour l'exemple) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TIMEZONE=Europe/Paris

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=abracadabra
MYSQL_USER=abracadabra_user
MYSQL_PASSWORD=abracadabra_password