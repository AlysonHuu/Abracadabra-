{% extends 'base.html.twig' %}

{% block title %}Détails de la Séance | Abracadabra{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <style>
        .show-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            max-width: 900px;
            margin: 40px auto;
            overflow: hidden;
            display: flex;
            flex-wrap: wrap;
        }

        .show-poster-side {
            flex: 1;
            min-width: 300px;
            background: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .show-poster-side img {
            max-width: 100%;
            border-radius: 8px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
        }

        .show-content-side {
            flex: 1.5;
            padding: 40px;
            min-width: 350px;
        }

        .show-content-side h1 {
            color: #8b0000;
            font-size: 2rem;
            margin-bottom: 25px;
            border-bottom: 2px solid #eee;
            padding-bottom: 15px;
        }

        .detail-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 20px;
        }

        .detail-icon {
            color: #8b0000;
            font-size: 1.2rem;
            width: 30px;
            text-align: center;
        }

        .detail-label {
            font-weight: bold;
            color: #666;
            font-size: 0.85rem;
            text-transform: uppercase;
            display: block;
        }

        .detail-value {
            color: #333;
            font-size: 1.1rem;
        }

        .occupancy-box {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-top: 25px;
        }

        .progress-container {
            height: 10px;
            background: #ddd;
            border-radius: 5px;
            margin: 10px 0;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: #8b0000;
        }

        /* --- STYLE CLIENT : PAIEMENT --- */
        .payment-section {
            margin-top: 25px;
            padding: 20px;
            background: #fdfdfd;
            border: 1px solid #eee;
            border-radius: 12px;
        }
        .btn-pay {
            background: #8b0000;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        .btn-pay:hover { background: #a00000; transform: translateY(-2px); }

        /* --- STYLE ADMIN : TABLEAU DE BORD --- */
        .admin-section {
            margin-top: 25px;
            padding: 20px;
            background: #fff5f5;
            border: 1px solid #ffcccc;
            border-radius: 12px;
        }
        .stat-box {
            background: white; 
            padding: 15px; 
            border-radius: 8px; 
            flex: 1; 
            text-align: center; 
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .action-bar {
            margin-top: 30px;
            display: flex;
            gap: 15px;
            align-items: center;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }

        .btn-secondary {
            color: #666;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 5px;
            background: #f1f1f1;
            padding: 10px 15px;
            border-radius: 5px;
            transition: 0.3s;
        }
        .btn-secondary:hover { background: #e2e2e2; }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="show-card">
        {# Côté gauche : Affiche du film #}
        <div class="show-poster-side">
            <img src="{{ asset('uploads/affiches/' ~ seance.film.affiche) }}" alt="Affiche {{ seance.film.nom }}">
        </div>

        {# Côté droit : Détails #}
        <div class="show-content-side">
            <h1><i class="fa-solid fa-ticket"></i> Détails de la séance</h1>

            <div class="detail-item">
                <div class="detail-icon"><i class="fa-solid fa-film"></i></div>
                <div>
                    <span class="detail-label">Film</span>
                    <span class="detail-value">{{ seance.film.nom }}</span>
                </div>
            </div>

            <div class="detail-item">
                <div class="detail-icon"><i class="fa-solid fa-calendar-day"></i></div>
                <div>
                    <span class="detail-label">Date et Heure</span>
                    <span class="detail-value">
                        Le {{ seance.dateDiffusion|date('d F Y') }} à **{{ seance.dateDiffusion|date('H:i') }}**
                    </span>
                </div>
            </div>

            <div class="detail-item">
                <div class="detail-icon"><i class="fa-solid fa-door-open"></i></div>
                <div>
                    <span class="detail-label">Salle</span>
                    <span class="detail-value">{{ seance.salle.nom }}</span>
                </div>
            </div>

            <div class="occupancy-box">
                <span class="detail-label">Remplissage de la salle</span>
                <div class="progress-container">
                    {% set percent = (seance.nbPlaceReservees|default(0) / seance.salle.nbPlaces * 100) %}
                    <div class="progress-bar" style="width: {{ percent }}%;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
                    <span>**{{ seance.nbPlaceReservees|default(0) }}** / {{ seance.salle.nbPlaces }} sièges</span>
                    <span>{{ (100 - percent)|round }}% libre</span>
                </div>
            </div>

            {# ========================================== #}
            {# SÉPARATION DES VUES : ADMIN VS CLIENT      #}
            {# ========================================== #}

            {% if is_granted('ROLE_ADMIN') %}
                
                {# --- VUE ADMINISTRATEUR (Tableau de bord) --- #}
                <div class="admin-section">
                    <h3 style="color: #8b0000; font-size: 1.1rem; margin-bottom: 15px;">
                        <i class="fa-solid fa-user-shield"></i> Espace Administrateur
                    </h3>
                    
                    <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                        <div class="stat-box">
                            <span style="display: block; font-size: 0.8rem; color: #666; text-transform: uppercase;">Chiffre d'Affaires</span>
                            <strong style="font-size: 1.5rem; color: #8b0000;">{{ seance.nbPlaceReservees|default(0) * 10 }} €</strong>
                        </div>
                        <div class="stat-box">
                            <span style="display: block; font-size: 0.8rem; color: #666; text-transform: uppercase;">Places Restantes</span>
                            <strong style="font-size: 1.5rem; color: #333;">{{ seance.salle.nbPlaces - seance.nbPlaceReservees|default(0) }}</strong>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; align-items: center;">
                        <a href="{{ path('app_seance_edit', {'id': seance.id}) }}" class="btn-secondary" style="background: white; border: 1px solid #ddd;">
                            <i class="fa-solid fa-pen"></i> Modifier cette séance
                        </a>
                        {{ include('seance/_delete_form.html.twig') }}
                    </div>
                </div>

            {% else %}

                {# --- VUE CLIENT (Module de Paiement) --- #}
                <div class="payment-section">
                    <h3 style="color: #333; font-size: 1.1rem; margin-bottom: 15px;">Réserver vos places</h3>
                    
                    <form action="{{ path('app_reservation_new', {'id': seance.id}) }}" method="POST">
                        <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                            <label for="nb_places" style="font-weight: bold; color: #555;">Nombre de billets :</label>
                            <input type="number" id="nb_places" name="nb_places" value="1" min="1" 
                                   max="{{ seance.salle.nbPlaces - seance.nbPlaceReservees }}" 
                                   style="width: 80px; padding: 10px; border: 2px solid #ddd; border-radius: 8px; font-weight: bold; text-align: center;">
                        </div>

                        <button type="submit" class="btn-pay">
                            <i class="fa-solid fa-credit-card"></i> Payer avec Stripe (10€ / place)
                        </button>
                    </form>
                    
                    <p style="font-size: 0.7rem; color: #aaa; margin-top: 12px; text-align: center;">
                        <i class="fa-solid fa-lock"></i> Paiement sécurisé simulé (Mode Test)
                    </p>
                </div>

            {% endif %}

            {# Barre d'action générale #}
            <div class="action-bar">
                <a href="{{ path('app_seance_index') }}" class="btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Retour au catalogue
                </a>
            </div>
        </div>
    </div>

    <div style="max-width: 900px; margin: 20px auto; color: #ccc; font-size: 0.8rem; text-align: center;">
        ID Séance : #{{ seance.id }} • Créée le {{ seance.createdAt|date('d/m/Y') }}
    </div>
</div>
{% endblock %}