{% extends 'base.html.twig' %}

{% block title %}Détails de la Séance | Abracadabra{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <style>
        .show-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            max-width: 900px;
            margin: 40px auto;
            overflow: hidden;
            display: flex;
            flex-wrap: wrap;
        }

        .show-poster-side {
            flex: 1;
            min-width: 300px;
            background: #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .show-poster-side img {
            max-width: 100%;
            border-radius: 8px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.5);
        }

        .show-content-side {
            flex: 1.5;
            padding: 40px;
            min-width: 350px;
        }

        .show-content-side h1 {
            color: #8b0000;
            font-size: 2rem;
            margin-bottom: 25px;
            border-bottom: 2px solid #eee;
            padding-bottom: 15px;
        }

        .detail-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 20px;
        }

        .detail-icon {
            color: #8b0000;
            font-size: 1.2rem;
            width: 30px;
            text-align: center;
        }

        .detail-label {
            font-weight: bold;
            color: #666;
            font-size: 0.85rem;
            text-transform: uppercase;
            display: block;
        }

        .detail-value {
            color: #333;
            font-size: 1.1rem;
        }

        .occupancy-box {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin-top: 25px;
        }

        .progress-container {
            height: 10px;
            background: #ddd;
            border-radius: 5px;
            margin: 10px 0;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: #8b0000;
        }

        /* Style spécifique pour le formulaire de paiement */
        .payment-section {
            margin-top: 25px;
            padding: 20px;
            background: #fdfdfd;
            border: 1px solid #eee;
            border-radius: 12px;
        }

        .btn-pay {
            background: #8b0000;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: bold;
            width: 100%;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-pay:hover {
            background: #a00000;
            transform: translateY(-2px);
        }

        .action-bar {
            margin-top: 30px;
            display: flex;
            gap: 15px;
            align-items: center;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }

        .btn-secondary {
            color: #666;
            text-decoration: none;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 5px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="show-card">
        {# Côté gauche : Affiche du film [cite: 66, 82] #}
        <div class="show-poster-side">
            <img src="{{ asset('uploads/affiches/' ~ seance.film.affiche) }}" alt="Affiche {{ seance.film.nom }}">
        </div>

        {# Côté droit : Détails #}
        <div class="show-content-side">
            <h1><i class="fa-solid fa-ticket"></i> Détails de la séance</h1>

            <div class="detail-item">
                <div class="detail-icon"><i class="fa-solid fa-film"></i></div>
                <div>
                    <span class="detail-label">Film</span>
                    <span class="detail-value">{{ seance.film.nom }}</span>
                </div>
            </div>

            <div class="detail-item">
                <div class="detail-icon"><i class="fa-solid fa-calendar-day"></i></div>
                <div>
                    <span class="detail-label">Date et Heure</span>
                    <span class="detail-value">
                        Le {{ seance.dateDiffusion|date('d F Y') }} à **{{ seance.dateDiffusion|date('H:i') }}**
                    </span>
                </div>
            </div>

            <div class="detail-item">
                <div class="detail-icon"><i class="fa-solid fa-door-open"></i></div>
                <div>
                    <span class="detail-label">Salle</span>
                    <span class="detail-value">{{ seance.salle.nom }}</span>
                </div>
            </div>

            <div class="occupancy-box">
                <span class="detail-label">Remplissage de la salle</span>
                <div class="progress-container">
                    {% set percent = (seance.nbPlaceReservees|default(0) / seance.salle.nbPlaces * 100) %}
                    <div class="progress-bar" style="width: {{ percent }}%;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.9rem;">
                    <span>**{{ seance.nbPlaceReservees|default(0) }}** / {{ seance.salle.nbPlaces }} sièges</span>
                    <span>{{ (100 - percent)|round }}% libre</span>
                </div>
            </div>

            {# SECTION PAIEMENT STRIPE #}
            <div class="payment-section">
                <h3 style="color: #333; font-size: 1.1rem; margin-bottom: 15px;">Réserver vos places</h3>
                
                <form action="{{ path('app_payment_checkout', {'id': seance.id}) }}" method="POST">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                        <label for="nb_places" style="font-weight: bold; color: #555;">Nombre de billets :</label>
                        <input type="number" id="nb_places" name="nb_places" value="1" min="1" 
                               max="{{ seance.salle.nbPlaces - seance.nbPlaceReservees }}" 
                               style="width: 80px; padding: 10px; border: 2px solid #ddd; border-radius: 8px; font-weight: bold; text-align: center;">
                    </div>

                    <button type="submit" class="btn-pay">
                        <i class="fa-solid fa-credit-card"></i> Payer avec Stripe (10€ / place)
                    </button>
                </form>
                
                <p style="font-size: 0.7rem; color: #aaa; margin-top: 12px; text-align: center;">
                    <i class="fa-solid fa-lock"></i> Paiement sécurisé simulé (Mode Test)
                </p>
            </div>

            <div class="action-bar">
                <a href="{{ path('app_seance_index') }}" class="btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Retour
                </a>
                
                {# On affiche Modifier/Supprimer uniquement si nécessaire (ex: admin) #}
                <div style="margin-left: auto; display: flex; gap: 10px; align-items: center;">
                    <a href="{{ path('app_seance_edit', {'id': seance.id}) }}" style="color: #d97706; text-decoration: none; font-size: 0.9rem;">
                        <i class="fa-solid fa-pen"></i> Modifier
                    </a>
                    {{ include('seance/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>

    <div style="max-width: 900px; margin: 20px auto; color: #ccc; font-size: 0.8rem; text-align: center;">
        ID Séance : #{{ seance.id }} • Programmée le {{ seance.createdAt|date('d/m/Y') }}
    </div>
</div>
{% endblock %}