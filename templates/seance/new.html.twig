{% extends 'base.html.twig' %}

{% block title %}Programmer une Séance{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_red.css">
    <style>
        .form-card { background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); max-width: 800px; margin: 40px auto; padding: 40px; }
        .dt-container { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .input-icon { position: relative; }
        .input-icon i { position: absolute; right: 15px; top: 15px; color: #8b0000; }
        .btn-save { background: #8b0000; color: white; border: none; padding: 15px; border-radius: 8px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 20px; transition: 0.3s; }
        .btn-save:hover { background: #600000; transform: translateY(-2px); }

       
        .preview-container {
            width: 100%;
            text-align: center;
            margin-bottom: 25px;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 10px;
            border: 2px dashed #ddd;
            display: none; 
        }
        #film-preview-img {
            max-width: 100%;
            max-height: 300px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            object-fit: contain;
        }
        .preview-title {
            font-size: 0.8rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            display: block;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="form-card">
        <h1 style="color: #8b0000; margin-bottom:30px;"><i class="fa-solid fa-clock-rotate-left"></i> Programmation</h1>

        {{ form_start(form) }}
            
          
            <div id="preview-box" class="preview-container">
                <span class="preview-title">Affiche du film sélectionné :</span>
                <img id="film-preview-img" alt="Prévisualisation de l'affiche">
            </div>

            <div class="dt-container">
                <div class="form-group">
                    {{ form_label(form.date_part) }}
                    <div class="input-icon">
                        {{ form_widget(form.date_part) }}
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                </div>
                <div class="form-group">
                    {{ form_label(form.time_part) }}
                    <div class="input-icon">
                        {{ form_widget(form.time_part) }}
                        <i class="fa-solid fa-clock"></i>
                    </div>
                </div>
            </div>

            <div class="dt-container">
                <div class="form-group">
                    {{ form_label(form.film) }}
                    {{ form_widget(form.film, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.salle) }}
                    {{ form_widget(form.salle, {'attr': {'class': 'form-control'}}) }}
                </div>
            </div>

            {{ form_rest(form) }}

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-calendar-check"></i> Enregistrer la séance
            </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
           
            flatpickr(".date-picker", {
                locale: "fr",
                minDate: "today",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d F Y"
            });

          
            flatpickr(".time-picker", {
                enableTime: true,
                noCalendar: true, 
                dateFormat: "H:i",
                time_24hr: true,
                minuteIncrement: 15
            });

          
            const moviePosters = {
                {% for choice in form.film.vars.choices %}
                    {% if choice.data.affiche is not empty %}
                        "{{ choice.value }}": "{{ asset('uploads/affiches/' ~ choice.data.affiche) }}",
                    {% endif %}
                {% endfor %}
            };

           
            const filmSelectNode = document.getElementById('{{ form.film.vars.id }}');
            const previewBox = document.getElementById('preview-box');
            const previewImg = document.getElementById('film-preview-img');

            if (filmSelectNode) {
               
                function updatePreview() {
                    const selectedId = filmSelectNode.value;
                    
                    if (selectedId && moviePosters[selectedId]) {
                        previewImg.src = moviePosters[selectedId];
                        previewBox.style.display = 'block';
                    } else {
                        previewBox.style.display = 'none';
                        previewImg.removeAttribute('src');
                    }
                }

             
                filmSelectNode.addEventListener('change', updatePreview);
                
             
                updatePreview();
            }
            
        });
    </script>
{% endblock %}