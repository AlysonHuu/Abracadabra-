{% extends 'base.html.twig' %}

{% block title %}Accueil - Abracadabra{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/homepage.css') }}">
{% endblock %}

{% block body %}

<div class="container my-4" style="max-width: 1200px;">
    <div id="pubCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#pubCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#pubCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#pubCarousel" data-bs-slide-to="2"></button>
        </div>
        <div class="carousel-inner" style="height: 500px; border-radius: 20px; overflow: hidden;">
            <div class="carousel-item active h-100">
                <img src="{{ asset('images/Menu.png') }}" class="d-block w-100 h-100" style="object-fit: cover;" alt="Menu">
            </div>
            <div class="carousel-item h-100">
                <img src="{{ asset('images/glace.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover;" alt="Glace">
            </div>
            <div class="carousel-item h-100">
                <img src="{{ asset('images/avatar_pub.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover;" alt="Avatar">
            </div>
        </div>
    </div>
</div>




<section class="carousel-section">
    <h2 class="section-title">À L'AFFICHE</h2>

    <div class="carousel-container">
        <button class="arrow left" onclick="prevSlide()">❮</button>

        <div class="movie-carousel"> 
            {% for film in films %}
                <div class="movie-card"> 
                    <img src="{{ film.Affiche ? asset('uploads/affiches/' ~ film.Affiche) : asset('images/no-poster.jpg') }}" alt="{{ film.Nom }}">
                    
                    <div class="film-info">
                        <h3>{{ film.Nom }}</h3>
                        <p>⏱ {{ film.Duree }} min</p>
                        
                        <a href="{{ path('app_film_show', {'id': film.id}) }}" class="btn">Réserver</a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <button class="arrow right" onclick="nextSlide()">❯</button>
    </div>
</section>

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/caroussel.js') }}"></script>
{% endblock %}



{% endblock %}