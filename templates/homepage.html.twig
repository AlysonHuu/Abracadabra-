{% extends 'base.html.twig' %}

{% block title %}Accueil - Abracadabra{% endblock %}

{% block body %}

<div class="container my-4" style="max-width: 1200px;">
    <div id="pubCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#pubCarousel" data-bs-slide-to="0" class="active"></button>
            <button type="button" data-bs-target="#pubCarousel" data-bs-slide-to="1"></button>
            <button type="button" data-bs-target="#pubCarousel" data-bs-slide-to="2"></button>
        </div>
        <div class="carousel-inner" style="height: 500px; border-radius: 20px; overflow: hidden;">
            <div class="carousel-item active h-100">
                <img src="{{ asset('images/Menu.png') }}" class="d-block w-100 h-100" style="object-fit: cover;" alt="Menu">
            </div>
            <div class="carousel-item h-100">
                <img src="{{ asset('images/glace.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover;" alt="Glace">
            </div>
            <div class="carousel-item h-100">
                <img src="{{ asset('images/avatar_pub.jpg') }}" class="d-block w-100 h-100" style="object-fit: cover;" alt="Avatar">
            </div>
        </div>
    </div>
</div>


<section class="carousel-section">
    <h2 class="section-title">À L'AFFICHE</h2>

    <div class="carousel-container">
        <button class="arrow left-arrow" onclick="prevSlide()">❮</button>

        <div class="carousel films-carousel">
            {% for film in films %}
                <div class="film-item">
                    <img src="{{ film.poster }}" alt="{{ film.titre }}">
                    <div class="film-info">
                        <h3>{{ film.titre }}</h3>
                        <p><i class="fa-regular fa-clock"></i> {{ film.duree }} min</p>
                        <div class="stars">
                            {% for i in 1..5 %}
                                <span class="star {{ i <= film.note ? 'filled' : '' }}">★</span>
                            {% endfor %}
                        </div>
                        <a href="{{ path('film_plus', {'id': film.id}) }}" class="btn-plus">En savoir plus</a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <button class="arrow right-arrow" onclick="nextSlide()">❯</button>
    </div>
</section>

<script>
let index = 0;

const items = document.querySelectorAll('.films-carousel .film-item');

function updateCarousel() {
    items.forEach((item, i) => {
      
        item.classList.remove('active', 'left', 'right', 'far-left', 'far-right');

        const total = items.length;

      
        if (i === index) {
            item.classList.add('active');
        } else if (i === (index - 1 + total) % total) {
            item.classList.add('left');
        } else if (i === (index - 2 + total) % total) {
            item.classList.add('far-left');
        } else if (i === (index + 1) % total) {
            item.classList.add('right');
        } else if (i === (index + 2) % total) {
            item.classList.add('far-right');
        }
    });
}

function nextSlide() {
    index = (index + 1) % items.length;
    updateCarousel();
}

function prevSlide() {
    index = (index - 1 + items.length) % items.length;
    updateCarousel();
}


document.addEventListener("DOMContentLoaded", updateCarousel);
</script>


{% endblock %}