{% extends 'base.html.twig' %}

{% block title %}Accueil - CinéPlus{% endblock %}

{% block body %}

<div class="hero">
    <div class="hero-text">
        <h1>Le charme du vrai cinéma</h1>
        <a href="#" class="btn">Voir les séances</a>
    </div>
</div>


<section class="carousel-section">
    <h2>À L'AFFICHE</h2>

    <div class="carousel-container">
        <button class="arrow left" onclick="prevSlide()">❮</button>

        <div class="carousel">
            {% for film in films %}
                <div class="carousel-item">
                    <img src="{{ film.poster }}" alt="{{ film.titre }}">
                    <div class="film-info">
                        <h3>{{ film.titre }}</h3>
                        <p>⏱ {{ film.duree }} min</p>
                        <div class="stars">
                            {% for i in 1..5 %}
                                {% if i <= film.note %}
                                    <span class="star filled">★</span>
                                {% else %}
                                    <span class="star">☆</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <a href="#" class="btn">Réserver</a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <button class="arrow right" onclick="nextSlide()">❯</button>
    </div>
</section>

<script>
let index = 0;
const items = document.querySelectorAll('.carousel-item');

function updateCarousel() {
    items.forEach((item, i) => {
        item.classList.remove('active', 'left', 'right');

        if (i === index) {
            item.classList.add('active');
        } else if (i === (index - 1 + items.length) % items.length) {
            item.classList.add('left');
        } else if (i === (index + 1) % items.length) {
            item.classList.add('right');
        }
    });
}

function nextSlide() {
    index = (index + 1) % items.length;
    updateCarousel();
}

function prevSlide() {
    index = (index - 1 + items.length) % items.length;
    updateCarousel();
}

updateCarousel();
</script>

<style>
.carousel-section {
    padding: 80px;
    text-align: center;
}

.carousel-container {
    position: relative;
    width: 100%;
    height: 650px; /* plus grand */
    display: flex;
    align-items: center;
    justify-content: center;
}

.carousel {
    position: relative;
    width: 800px;
    height: 600px; /* plus grand */
}

.carousel-item {
    position: absolute;
    width: 300px;
    transition: 0.5s;
    opacity: 0;
    transform: scale(0.8);
    text-align: center;
}

.carousel-item img {
    width: 100%;
    border-radius: 15px;
    display: block;
}

.carousel-item.active {
    transform: scale(1);
    opacity: 1;
    left: 250px;
    z-index: 3;
}

.carousel-item.left {
    transform: scale(0.85);
    opacity: 0.3;
    left: 0;
    z-index: 2;
}

.carousel-item.right {
    transform: scale(0.85);
    opacity: 0.3;
    left: 500px;
    z-index: 2;
}

.film-info {
    margin-top: 15px;
}

.stars {
    margin: 10px 0;
}

.star {
    font-size: 22px;
    color: #ccc;
}

.star.filled {
    color: gold;
}

.btn {
    display: inline-block;
    margin-top: 10px;
}

.arrow {
    background: #8B0000;
    color: white;
    border: none;
    font-size: 25px;
    padding: 10px 15px;
    cursor: pointer;
    border-radius: 50%;
    margin: 20px;
}

.arrow:hover {
    background: #a80000;
}
</style>

{% endblock %}
