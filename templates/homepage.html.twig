{% extends 'base.html.twig' %}

{% block title %}Accueil - CinéPlus{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/homepage.css') }}">
{% endblock %}

{% block body %}

<div class="hero">
    <div class="hero-text">
        <h1>Le charme du vrai cinéma</h1>
        <a href="#" class="btn">Voir les séances</a>
    </div>
</div>


<section class="carousel-section">
    <h2>À L'AFFICHE</h2>

    <div class="carousel-container">
        <button class="arrow left" onclick="prevSlide()">❮</button>

        <div class="carousel">
            {% for film in films %}
                <div class="carousel-item">
                    <img src="{{ asset('uploads/posters/' ~ film.Affiche) }}" alt="Affiche">                    
                    <div class="film-info">
                        <h3>{{ film.titre }}</h3>
                        <p>⏱ {{ film.duree }} min</p>
                        <div class="stars">
                            {% for i in 1..5 %}
                                {% if i <= film.note %}
                                    <span class="star filled">★</span>
                                {% else %}
                                    <span class="star">☆</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <a href="#" class="btn">Réserver</a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <button class="arrow right" onclick="nextSlide()">❯</button>
    </div>
</section>

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/caroussel.js') }}"></script>
{% endblock %}



{% endblock %}
