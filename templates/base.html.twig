<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Abracadabra Cinéma{% endblock %}</title>

   
    <link rel="icon" href="{{ asset('images/logo.png') }}" type="image/png">


    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/f6563890e5.js" crossorigin="anonymous"></script>

   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">
    
    {% block stylesheets %}
    <style>
        
        .navbar-brand img {
            transition: transform 0.3s ease;
        }
        .navbar-brand img:hover {
            transform: scale(1.08);
        }
    </style>
    {% endblock %}
</head>
<body>

 <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
    <div class="container-fluid">
      
      
      <a class="navbar-brand" href="{{ path('cinema_homepage') }}" style="padding: 0; margin-right: 25px;">
          <img src="{{ asset('images/logo.png') }}" alt="Logo Abracadabra" style="height: 80px; object-fit: contain;">
      </a>
      
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="{{ path('cinema_homepage') }}">Accueil</a></li>
          
         
          {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item"><a class="nav-link" href="{{ path('app_film_index') }}">FILMS</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_salle_index') }}">SALLES</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_seance_index') }}">SÉANCES</a></li>
          {% endif %}
          
          {% if is_granted('ROLE_USER') and not is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a href="{{ path('app_reservation_index') }}" class="nav-link">
                        <i class="fa-solid fa-ticket"></i> Mes Réservations
                    </a>
                </li>
          {% endif %}
          
          {% if not is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_oracle') }}">
                        <i class="fa-solid fa-wand-sparkles"></i> L'Oracle
                    </a>
                </li>
          {% endif %}
        </ul>

       
        <form class="search-container me-3" role="search" action="{{ path('app_film_search') }}" method="get">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
           
            <input class="form-control search-input" type="search" name="q" placeholder="Rechercher un film..." aria-label="Search" value="{{ app.request.query.get('q') }}">
        </form>

        
        <div class="d-flex align-items-center">
            {% if app.user %}
                <a href="{{ path('app_mon_compte') }}" class="text-white" title="Mon Compte">
                    <i class="fa-solid fa-circle-user fa-lg" style="color: #FFD700;"></i>
                </a>
                <a href="{{ path('app_logout') }}" class="ms-3 text-white" title="Déconnexion">
                    <i class="fa-solid fa-power-off"></i>
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="text-white" title="Connexion">
                    <i class="fa-solid fa-circle-user fa-lg"></i>
                </a>
            {% endif %}
        </div>

      </div>
    </div>
 </nav>

 <main class="main-content">
    {% block body %}{% endblock %}
 </main>

 <footer>
    <p>&copy; {{ "now"|date("Y") }} Abracadabra Cinéma — L'expérience magique.</p>
 </footer>

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 {% block javascripts %}{% endblock %}
</body>
</html>