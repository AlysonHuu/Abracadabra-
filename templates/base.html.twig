<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Abracadabra Cinéma{% endblock %}</title>

    {# Polices et icônes #}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/f6563890e5.js" crossorigin="anonymous"></script>

    {# Frameworks #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/main.css') }}">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>

 <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
    <div class="container-fluid">
      <a class="navbar-brand" href="{{ path('cinema_homepage') }}">ABRACADABRA</a>
      
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="{{ path('cinema_homepage') }}">Accueil</a></li>
          
          {# Menu réservé UNIQUEMENT aux administrateurs #}
          {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-item"><a class="nav-link" href="{{ path('app_film_index') }}">FILMS</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_salle_index') }}">SALLES</a></li>
            <li class="nav-item"><a class="nav-link" href="{{ path('app_seance_index') }}">SÉANCES</a></li>
          {% endif %}
        </ul>

        {# BARRE DE RECHERCHE #}
        <form class="search-container me-3" role="search">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input class="form-control search-input" type="search" placeholder="Rechercher un film..." aria-label="Search">
        </form>

        {# GESTION DU COMPTE #}
        <div class="d-flex align-items-center">
            {% if app.user %}
                {# Si l'utilisateur est connecté : Icône Mon Compte (Dorée) et Déconnexion #}
                <a href="{{ path('app_mon_compte') }}" class="text-white" title="Mon Compte">
                    <i class="fa-solid fa-circle-user fa-lg" style="color: #FFD700;"></i>
                </a>
                <a href="{{ path('app_logout') }}" class="ms-3 text-white" title="Déconnexion">
                    <i class="fa-solid fa-power-off"></i>
                </a>
            {% else %}
                {# Si l'utilisateur n'est pas connecté : Icône de connexion standard #}
                <a href="{{ path('app_login') }}" class="text-white" title="Connexion">
                    <i class="fa-solid fa-circle-user fa-lg"></i>
                </a>
            {% endif %}
        </div>

      </div>
    </div>
 </nav>

 <main class="main-content">
    {% block body %}{% endblock %}
 </main>

 <footer>
    <p>&copy; {{ "now"|date("Y") }} Abracadabra Cinéma — L'expérience magique.</p>
 </footer>

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 {% block javascripts %}{% endblock %}
</body>
</html>