{% extends 'base.html.twig' %}

{% block title %}Connexion | Abracadabra{% endblock %}

{% block body %}
<style>
    h2 {
        font-size:small;
    }
    .slider-container {
        position: relative;
        height: 300px; 
        width: 100%;
        max-width: 600px; /* Optionnel : évite que le texte s'étale trop sur écran géant */
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .slide {
        position: absolute;
        /* On enlève le top/left 50% qui peut créer des décalages si mal géré */
        width: 100%;
        opacity: 0;
        transition: opacity 0.8s ease-in-out;
        display: none;
    }

    .slide.active {
        display: block;
        opacity: 1;
    }

    .dots {
        margin-top: 20px;
    }

    .dot {
        height: 10px;
        width: 10px;
        background-color: rgba(255, 255, 255, 0.3);
        border-radius: 50%;
        display: inline-block;
        margin: 0 5px;
    }

    .dot.active {
        background-color: white;
    }
        .btn-login:hover {
        background-color: #6a0000;
        transform: translateY(-2px); /* Le bouton remonte légèrement */
        box-shadow: 0 5px 15px rgba(139, 0, 0, 0.4); /* Ombre plus forte au survol */
    }
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background-color: #f4f4f4;
    }

    .split-container {
        display: flex;
        height: 100vh;
        width: 100%;
    }

    /* Partie Gauche : Décorative */
    .left-side {
        flex: 1.2;
        background: linear-gradient(135deg, #570808 0%, #a30303 100%);
        display: flex;
        flex-direction: column;   /* Aligne les éléments verticalement (Titre -> Points) */
        justify-content: center; /* Centre verticalement dans la colonne */
        align-items: center;     /* Centre horizontalement dans la colonne */
        color: white;
        padding: 40px;
        text-align: center;      /* Force le texte à rester au milieu */
        position: relative;      /* Nécessaire pour les slides en absolute */
    }

    .left-side h2 { font-size: 3rem; margin-bottom: 10px; }
    .left-side p { font-size: 1.2rem; opacity: 0.8; max-width: 400px; }

    /* Partie Droite : Formulaire */
    .right-side {
        flex: 1;
        background: white;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
    }

    .login-box {
        width: 100%;
        max-width: 380px;
    }

    .login-box h1 { color: #333; margin-bottom: 30px; font-size: 2rem; }

    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #555; }
    .form-group input {
        width: 100%;
        padding: 12px;
        border: 2px solid #eee;
        border-radius: 8px;
        transition: border-color 0.3s;
        box-sizing: border-box;
    }
    .form-group input:focus { border-color: #8b0000; outline: none; }

    .btn-login {
        width: 100%;
        padding: 15px;
        background: #8b0000;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        font-size: 1rem;
    }

    /* Responsive : sur téléphone, on cache la partie gauche */
    @media (max-width: 768px) {
        .left-side { display: none; }
    }
</style>

<div class="split-container">
<div class="left-side">
    <div class="slider-container">
        <div class="slide active">
            <h2>I AAM Cinéma</h2>
            <!--<p>Profitez d'un moment en famille en regardant un film !</p>-->
        </div>
        <div class="slide">
            <h2>Offre du moment ! <br> UNE PLACE ACHETE = UNE PLACE OFFERTE  </h2>
            <!--<p>Profitez d'un moment en amoureux a moindre prix ! <br> UNE PLACE ACHETE = UNE PLACE OFFERTE </p>-->
        </div>
        <div class="slide">
            <h2>En ce moment en salle ! <br> <b> Avatar : de Feu et de Cendres</b></h2>
           
        </div>
    </div>
    
    <div class="dots">
        <span class="dot active"></span>
        <span class="dot"></span>
        <span class="dot"></span>
    </div>
</div>

    <div class="right-side">
        <div class="login-box">
            <h1>Connexion</h1>
            <form method="post">
                <div class="form-group">
                    <label>Identifiant (Email)</label>
                    <input type="email" name="email" placeholder="jean.dupont@mail.com" required>
                </div>
                <div class="form-group">
                    <label>Mot de passe</label>
                    <input type="password" name="password" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn-login">Accéder à mon espace</button>
            </form>
        </div>
    </div>
</div>
<script>
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    let currentSlide = 0;

    function showSlide(index) {
        // On enlève la classe active partout
        slides.forEach(s => s.classList.remove('active'));
        dots.forEach(d => d.classList.remove('active'));

        // On l'ajoute sur le slide actuel
        slides[index].classList.add('active');
        dots[index].classList.add('active');
    }

    function nextSlide() {
        currentSlide = (currentSlide + 1) % slides.length;
        showSlide(currentSlide);
    }

    // Change de message toutes les 4 secondes
    setInterval(nextSlide, 4000);
</script>
{% endblock %}