{% extends 'base.html.twig' %}

{% block title %}Mon Compte | Abracadabra{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <style>
        .account-wrapper {
            display: flex;
            min-height: calc(100vh - 180px);
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            max-width: 1300px;
            margin: 30px auto;
        }

        .reservations-side {
            flex: 1.4;
            background: linear-gradient(135deg, #8b0000 0%, #5a0000 100%);
            color: white;
            padding: 50px;
            display: flex;
            flex-direction: column;
        }

        .reservations-side h2 { font-size: 2.8rem; margin-bottom: 10px; font-weight: 800; }
        .reservations-side p.subtitle { opacity: 0.8; margin-bottom: 40px; }

        .carousel-container {
            display: flex;
            gap: 25px;
            overflow-x: auto;
            padding: 20px 5px;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
        }
        .carousel-container::-webkit-scrollbar { display: none; }

        .reservation-card {
            flex: 0 0 220px;
            background: white;
            color: #333;
            border-radius: 15px;
            overflow: hidden;
            scroll-snap-align: start;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .reservation-card:hover { transform: scale(1.05); }

        .card-poster { width: 100%; height: 280px; object-fit: cover; }
        .card-body { padding: 15px; }
        .card-body h3 { font-size: 1.1rem; margin-bottom: 8px; color: #8b0000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-info { font-size: 0.85rem; color: #666; margin-bottom: 4px; }
        
        .qr-placeholder {
            margin-top: 15px;
            padding: 10px;
            background: #f8f8f8;
            border: 2px dashed #ddd;
            border-radius: 8px;
            text-align: center;
            font-size: 0.7rem;
            color: #aaa;
        }

        .info-side {
            flex: 1;
            padding: 50px;
            background: #fff;
            overflow-y: auto;
        }

        .info-side h2 { color: #333; margin-bottom: 35px; position: relative; }
        .info-side h2::after { content: ''; position: absolute; left: 0; bottom: -10px; width: 50px; height: 4px; background: #8b0000; }

        .form-group { margin-bottom: 20px; }
        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #f0f0f0;
            border-radius: 10px;
            transition: border-color 0.3s;
        }
        .form-control:focus { border-color: #8b0000; outline: none; }

        .btn-update {
            background: #8b0000; color: white; border: none; padding: 15px;
            width: 100%; border-radius: 10px; font-weight: bold; cursor: pointer;
            box-shadow: 0 4px 15px rgba(139,0,0,0.2);
            display: flex; align-items: center; justify-content: center; gap: 10px;
            transition: 0.3s;
        }
        .btn-update:hover { background: #a00000; transform: translateY(-2px); }
        
        .flash-toast {
            position: fixed; top: 20px; right: 20px; z-index: 9999;
            background: #27ae60; color: white; padding: 15px 30px;
            border-radius: 12px; box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            animation: slideIn 0.5s forwards, fadeOut 0.5s 3s forwards;
        }

        @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
        @keyframes fadeOut { to { opacity: 0; visibility: hidden; } }
    </style>
{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="flash-toast">
            <i class="fa-solid fa-circle-check"></i> {{ message }}
        </div>
    {% endfor %}

    <div class="account-wrapper">

        
        <div class="reservations-side">
            <h2>Mes Réservations</h2>
            
            {% set active_reservations = [] %}
            {% for reservation in app.user.reservations %}
                {% if reservation.seance.dateDiffusion >= date() %}
                    {% set active_reservations = active_reservations|merge([reservation]) %}
                {% endif %}
            {% endfor %}

            {% if active_reservations|length > 0 %}
                <p class="subtitle">Préparez le pop-corn ! Voici vos prochaines séances :</p>
                <div class="carousel-container">
                    {% set seances_affichees = [] %}
                    {% for res in active_reservations %}
                        {% if res.seance.id not in seances_affichees %}
                            <div class="reservation-card">
                                <a href="{{ path('app_reservation_index') }}" style="text-decoration: none; display: block;">
                                    <img src="{{ asset('uploads/affiches/' ~ res.seance.film.affiche) }}" class="card-poster" alt="Affiche">
                                    <div class="card-body">
                                        <h3>{{ res.seance.film.nom }}</h3>
                                        <div class="card-info"><i class="fa-solid fa-calendar-day"></i> {{ res.seance.dateDiffusion|date('d/m/Y') }}</div>
                                        <div class="card-info"><i class="fa-solid fa-clock"></i> {{ res.seance.dateDiffusion|date('H:i') }}</div>
                                        <div class="qr-placeholder">
                                            <i class="fa-solid fa-qrcode"></i><br>QR Code bientôt disponible
                                        </div>
                                    </div>
                                </a>
                            </div>
                            {% set seances_affichees = seances_affichees|merge([res.seance.id]) %}
                        {% endif %}
                    {% endfor %}
                </div>
            {% else %}
                <div style="margin-top: 50px; text-align: center; opacity: 0.6;">
                    <i class="fa-solid fa-ticket" style="font-size: 4rem; margin-bottom: 20px; display: block;"></i>
                    <p>Vous n'avez pas de réservation pour le moment.</p>
                </div>
            {% endif %}

            {% set nb_payantes = 0 %}
            {% for res in app.user.reservations %}
                {% if not res.gratuite %}
                    {% set nb_payantes = nb_payantes + 1 %}
                {% endif %}
            {% endfor %}
            {% set progression = nb_payantes % 5 %}
            {% set bons_dispo  = app.user.bonsFideliteDisponibles|length %}

            <div style="margin-top: 30px; background: rgba(255,255,255,0.12);
                        border-radius: 15px; padding: 20px;
                        border: 1px solid rgba(255,255,255,0.2);">

                <p style="font-weight: bold; margin-bottom: 12px; font-size: 1rem; margin-top: 0;">
                    <i class="fa-solid fa-star" style="color: #ffd700;"></i> Programme Fidélité
                </p>

                <div style="background: rgba(0,0,0,0.25); border-radius: 10px;
                            height: 12px; overflow: hidden; margin-bottom: 8px;">
                    <div style="background: linear-gradient(90deg, #ffd700, #ffaa00);
                                height: 100%; border-radius: 10px;
                                width: {{ ((progression / 5) * 100)|round }}%;
                                transition: width 1.2s ease;"></div>
                </div>

                <p style="font-size: 0.85rem; opacity: 0.85; margin-bottom: 0;">
                    {% if nb_payantes == 0 %}
                        Effectuez votre 1ère réservation pour démarrer !
                    {% elseif progression == 0 %}
                        🎉 Palier atteint ! Consultez vos bons ci-dessous.
                    {% else %}
                        {{ progression }} / 5 réservations avant votre prochain billet offert
                    {% endif %}
                </p>

                {% if bons_dispo > 0 %}
                    <div style="margin-top: 15px; padding: 12px; background: rgba(255,215,0,0.15);
                                border-radius: 10px; border: 1px solid rgba(255,215,0,0.4);">
                        <p style="color: #ffd700; font-weight: bold; margin-bottom: 8px; font-size: 0.9rem;">
                            <i class="fa-solid fa-gift"></i> {{ bons_dispo }} bon(s) disponible(s) !
                        </p>
                        {% for bon in app.user.bonsFideliteDisponibles %}
                            <div style="font-family: 'Courier New', monospace; font-size: 0.85rem;
                                        background: rgba(255,255,255,0.1); padding: 6px 12px;
                                        border-radius: 6px; margin-bottom: 4px; letter-spacing: 1px;">
                                🎟️ <strong>{{ bon.code }}</strong>
                                <span style="font-size: 0.75rem; opacity: 0.7; margin-left: 8px;">
                                    — utilisable à la prochaine réservation
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if app.user.age is not null and app.user.age < 25 %}
                    <p style="margin-top: 12px; margin-bottom: 0; font-size: 0.82rem; color: #a8f0a8;">
                        <i class="fa-solid fa-tag"></i>
                        Tarif Jeune actif — vous bénéficiez de −40% sur chaque place !
                    </p>
                {% endif %}
            </div>

            <div style="margin-top: auto; padding-top: 20px;">
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_film_index') }}" style="color: white; text-decoration: none; font-size: 0.9rem; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-plus-circle"></i> Gérer les films
        </a>
    {% else %}
        <a href="{{ path('cinema_homepage') }}" style="color: white; text-decoration: none; font-size: 0.9rem; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-plus-circle"></i> Explorer les films
        </a>
    {% endif %}
</div>
        </div>

        
        <div class="info-side">
            <h2>Mes Informations</h2>
            
            {{ form_start(form) }}

                
                <div class="form-group">
                {{ form_row(form.email, {'attr': {'class': 'form-control', 'style': 'background:#f8f8f8; cursor:not-allowed; color:#888;'}}) }}
                </div>

                
                <div style="display: flex; gap: 15px;">
                    <div class="form-group" style="flex: 1;">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="form-group" style="flex: 1;">
                        {{ form_label(form.prenom) }}
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>

           
                <div class="form-group">
                    {{ form_label(form.dateNaissance, 'Date de naissance') }}
                    {{ form_widget(form.dateNaissance, {'attr': {'class': 'form-control'}}) }}
                    <small style="color: #888; font-size: 0.8rem;">
                        <i class="fa-solid fa-info-circle"></i>
                        Renseignez votre date de naissance pour bénéficier du tarif jeune (−40% avant 25 ans).
                    </small>
                </div>

                
                <div style="margin: 30px 0; padding: 25px; border-radius: 12px; background: #fffcf0; border: 1px solid #ffeeba;">
                    <p style="font-size: 0.85rem; color: #856404; margin-bottom: 15px; font-weight: bold;">
                        <i class="fa-solid fa-lock"></i> Sécurité du compte
                    </p>
                    <div class="form-group">
                        {{ form_label(form.plainPassword.first, 'Nouveau mot de passe') }}
                        {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Laisser vide pour ne pas changer'}}) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.plainPassword.second, 'Confirmer le mot de passe') }}
                        {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>

                <button type="submit" class="btn-update">
                    <i class="fa-solid fa-rotate"></i> Mettre à jour mon profil
                </button>

            {{ form_end(form) }}

            <div style="margin-top: 30px; border-top: 1px solid #eee; padding-top: 20px;">
                <form method="post" action="{{ path('app_delete_account') }}" 
                      onsubmit="return confirm('La suppression de votre compte est définitive. Continuer ?');">
                    <button style="background: none; border: none; color: #dc3545; cursor: pointer; 
                                   font-size: 0.85rem; display: flex; align-items: center; gap: 8px; 
                                   opacity: 0.7; transition: 0.3s;">
                        <i class="fa-solid fa-trash-can"></i> Supprimer définitivement mon compte
                    </button>
                </form>
            </div>
        </div>

    </div>
{% endblock %}