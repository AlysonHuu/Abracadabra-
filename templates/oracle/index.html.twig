{% extends 'base.html.twig' %}

{% block title %}L'Oracle M. SCHNEIDER | Abracadabra{% endblock %}

{% block stylesheets %}
<style>
    
    /* Simulation d'étoiles scintillantes */
    .oracle-page-wrapper::before {
        content: "";
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: url('https://www.transparenttextures.com/patterns/stardust.png');
        opacity: 0.4;
        animation: starsMove 100s linear infinite;
    }

    @keyframes starsMove { from { background-position: 0 0; } to { background-position: 1000px 1000px; } }

    /* 2. LA BOULE DE CRISTAL (Inspirée de ta photo) */
    .crystal-ball-outer {
        width: 380px;
        height: 380px;
        position: relative;
        margin: 20px 0;
        z-index: 10;
        filter: drop-shadow(0 0 50px rgba(138, 43, 226, 0.6));
    }

    .crystal-ball {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        position: relative;
        overflow: hidden;
        border: 4px solid rgba(255, 255, 255, 0.1);
        /* Reflet de verre sur la boule */
        box-shadow: inset 0 20px 30px rgba(255, 255, 255, 0.2), 
                    inset 10px 0 30px rgba(138, 43, 226, 0.4),
                    inset -10px 0 30px rgba(75, 0, 130, 0.4);
    }

    /* LE FLUIDE MYSTIQUE À L'INTÉRIEUR */
    .mystic-fluid {
        position: absolute;
        width: 200%; height: 200%;
        top: -50%; left: -50%;
        /* Dégradé tourbillonnant */
        background: conic-gradient(from 0deg, transparent, #8a2be2, #4b0082, transparent);
        filter: blur(40px);
        opacity: 0.6;
        animation: fluidRotate 10s infinite linear;
    }

    @keyframes fluidRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    /* Animation accélérée quand on attend la réponse */
    .active-oracle .mystic-fluid {
        animation: fluidRotate 2s infinite linear;
        opacity: 0.9;
        filter: blur(25px);
    }

    /* Le socle de la boule */
    .ball-base {
        width: 180px;
        height: 40px;
        background: linear-gradient(to bottom, #333, #000);
        margin: -25px auto 0;
        border-radius: 50% / 100% 100% 0 0;
        position: relative;
        z-index: 5;
        border-top: 2px solid #555;
    }

    /* 3. INTERFACE SOBRE */
    .oracle-ui { position: relative; z-index: 20; width: 100%; max-width: 600px; margin-top: 30px; }
    
    .oracle-input {
        background: rgba(0, 0, 0, 0.5);
        border: 1px solid #8a2be2;
        color: #fff;
        padding: 18px 30px;
        border-radius: 40px;
        width: 80%;
        font-size: 1.1rem;
        backdrop-filter: blur(5px);
        outline: none;
        transition: 0.3s;
    }
    .oracle-input:focus { box-shadow: 0 0 20px rgba(138, 43, 226, 0.5); }

    .btn-magic {
        margin-top: 20px;
        background: #8b0000;
        color: white;
        border: none;
        padding: 12px 40px;
        border-radius: 30px;
        font-weight: bold;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.3s;
    }
    .btn-magic:hover { transform: scale(1.05); box-shadow: 0 0 20px #8b0000; }


    /* Ajoutez du padding en bas pour ne pas coller au footer */
.oracle-page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow-y: auto; /* Permet le scroll si la réponse est longue */
    background: radial-gradient(ellipse at bottom, #1B2735 0%, #090A0F 100%);
    color: #f4ecd8;
    padding: 60px 20px 120px 20px; /* Augmentation du padding en bas (120px) */
}

/* Espacement sous la carte de prédiction */
.prediction-card {
    margin-top: 40px;
    margin-bottom: 40px; /* Espace supplémentaire sous la réponse */
    padding: 30px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 15px;
    font-family: 'Georgia', serif;
    font-size: 1.3rem;
    line-height: 1.6;
    max-width: 700px;
    border: 1px solid rgba(138, 43, 226, 0.2);
    backdrop-filter: blur(10px);
}
</style>
{% endblock %}

{% block body %}
<div class="oracle-page-wrapper {% if reponse %}active-oracle{% endif %}">
    <h1 style="font-weight: 200; letter-spacing: 15px; margin-bottom: 0;">M. SCHNEIDER</h1>
    <p style="text-transform: uppercase; font-size: 0.7rem; letter-spacing: 4px; color: #8a2be2; font-weight: bold;">Le Miroir des Âmes</p>

    <div class="crystal-ball-outer">
        <div class="crystal-ball">
            <div class="mystic-fluid"></div>
            {# Reflet de lumière sur le verre #}
            <div style="position: absolute; top: 15%; left: 20%; width: 60px; height: 30px; background: rgba(255,255,255,0.1); border-radius: 50%; transform: rotate(-30deg); filter: blur(5px);"></div>
        </div>
        <div class="ball-base"></div>
    </div>

    <form action="{{ path('app_oracle') }}" method="get" class="oracle-ui" onsubmit="startDivination()">
        <input type="text" name="q" class="oracle-input" placeholder="Quelle vérité cherchez-vous ?" value="{{ question }}" required>
        <br>
        <button type="submit" class="btn-magic">Invoquer l'Oracle</button>
    </form>

    {% if reponse %}
        <div class="prediction-card">
            <i class="fa-solid fa-wand-magic-sparkles" style="color: #8a2be2; margin-bottom: 15px; display: block;"></i>
            {{ reponse }}
        </div>
    {% endif %}
</div>

<script>
function startDivination() {
    // On force l'accélération des fluides au clic
    document.querySelector('.oracle-page-wrapper').classList.add('active-oracle');
}
</script>
{% endblock %}