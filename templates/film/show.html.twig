{% extends 'base.html.twig' %}

{% block title %}Film{% endblock %}

{% block body %}
    <h1>Film</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ film.id }}</td>
            </tr>
            <tr>
                <th>Affiche</th>
                <td>{{ film.Affiche }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ film.Nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ film.Description }}</td>
            </tr>
            <tr>
                <th>Genre</th>
                <td>{{ film.Genre }}</td>
            </tr>
            <tr>
                <th>EstDispo</th>
                <td>{{ film.estDispo ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>DateSortie</th>
                <td>{{ film.dateSortie ? film.dateSortie|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Duree</th>
                <td>{{ film.Duree }}</td>
            </tr>
            <tr>
                <th>Note</th>
                <td>{{ film.Note }}</td>
            </tr>
            <tr>
                <th>Commentaire</th>
                <td>{{ film.Commentaire }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ film.createdAt ? film.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ film.updatedAt ? film.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DeletedAt</th>
                <td>{{ film.deletedAt ? film.deletedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_film_index') }}">back to list</a>

    <a href="{{ path('app_film_edit', {'id': film.id}) }}">edit</a>

    {{ include('film/_delete_form.html.twig') }}
{% endblock %}
