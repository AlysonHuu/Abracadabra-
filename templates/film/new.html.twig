{% extends 'base.html.twig' %}

{% block title %}Nouveau Film | Abracadabra{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_red.css">
    <style>
        .form-card { background: white; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); max-width: 800px; margin: 40px auto; padding: 40px; }
        .dt-container { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .form-group { margin-bottom: 15px; }
        .form-group label { font-weight: bold; color: #333; margin-bottom: 5px; display: block; }
        .form-control { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-family: inherit; }
        .form-control:focus { outline: none; border-color: #8b0000; box-shadow: 0 0 5px rgba(139,0,0,0.3); }
        .btn-save { background: #8b0000; color: white; border: none; padding: 15px; border-radius: 8px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 20px; transition: 0.3s; }
        .btn-save:hover { background: #600000; transform: translateY(-2px); }
        .back-link { display: block; text-align: center; margin-top: 20px; color: #8b0000; text-decoration: none; font-weight: bold; }
        .back-link:hover { text-decoration: underline; }

        /* ZONE DE PRÉVISUALISATION DE L'AFFICHE */
        .preview-container {
            width: 100%;
            text-align: center;
            margin-bottom: 25px;
            padding: 20px;
            background-color: #f9f9f9;
            border-radius: 10px;
            border: 2px dashed #ddd;
            display: none; /* Caché par défaut, affiché par JS */
        }
        #affiche-preview-img {
            max-width: 100%;
            max-height: 300px;
            border-radius: 8px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            object-fit: contain;
        }
        .preview-title {
            font-size: 0.8rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 10px;
            display: block;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="form-card">
        <h1 style="color: #8b0000; margin-bottom:30px; text-align:center;"><i class="fa-solid fa-film"></i> Ajouter un Film</h1>

        {{ form_start(form) }}

            {# ZONE D'AFFICHAGE DE LA PRÉVISUALISATION (Cachée au début) #}
            <div id="preview-box" class="preview-container">
                <span class="preview-title">Affiche sélectionnée :</span>
                {# MODIFICATION ICI : On a enlevé src="#" pour éviter l'icône d'image brisée #}
                <img id="affiche-preview-img" alt="Prévisualisation de l'affiche">
            </div>

            {# Première ligne : Nom et Genre #}
            <div class="dt-container">
                <div class="form-group">
                    {{ form_label(form.Nom) }}
                    {{ form_widget(form.Nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Inception'}}) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.Genre) }}
                    {{ form_widget(form.Genre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Science-Fiction'}}) }}
                </div>
            </div>

            {# Deuxième ligne : Date et Durée #}
            <div class="dt-container">
                <div class="form-group">
                    {{ form_label(form.dateSortie) }}
                    <div class="input-icon" style="position:relative;">
                        {{ form_widget(form.dateSortie, {'attr': {'class': 'form-control date-picker'}}) }}
                        <i class="fa-solid fa-calendar" style="position:absolute; right:15px; top:12px; color:#8b0000; pointer-events:none;"></i>
                    </div>
                </div>
                <div class="form-group">
                    {{ form_label(form.Duree) }}
                    {{ form_widget(form.Duree, {'attr': {'class': 'form-control', 'placeholder': 'En minutes (ex: 148)'}}) }}
                </div>
            </div>

            {# Troisième ligne : Note et Disponibilité #}
            <div class="dt-container">
                <div class="form-group">
                    {{ form_label(form.Note) }}
                    {{ form_widget(form.Note, {'attr': {'class': 'form-control', 'placeholder': 'Sur 5'}}) }}
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin-top: 25px;">
                    {{ form_widget(form.estDispo, {'attr': {'style': 'width: 20px; height: 20px; cursor: pointer;'}}) }}
                    {{ form_label(form.estDispo, 'Film actuellement à l\'affiche', {'label_attr': {'style': 'margin:0; cursor: pointer;'}}) }}
                </div>
            </div>

            {# Fichier Affiche (Prend toute la largeur) #}
            <div class="form-group">
                {{ form_label(form.Affiche, 'Choisir l\'affiche (JPG/PNG)') }}
                {# MODIFICATION ICI : On a forcé l'ID 'affiche-input' et l'attribut 'accept' #}
                {{ form_widget(form.Affiche, {'attr': {'id': 'affiche-input', 'class': 'form-control', 'style': 'padding: 7px;', 'accept': 'image/*'}}) }}
            </div>

            {# Textes longs (Prennent toute la largeur) #}
            <div class="form-group">
                {{ form_label(form.Description) }}
                {{ form_widget(form.Description, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.Commentaire) }}
                {{ form_widget(form.Commentaire, {'attr': {'class': 'form-control', 'rows': '2'}}) }}
            </div>

            <button type="submit" class="btn-save">
                <i class="fa-solid fa-check"></i> Enregistrer le film
            </button>
        {{ form_end(form) }}

        <a href="{{ path('app_film_index') }}" class="back-link"><i class="fa-solid fa-arrow-left"></i> Retour à la liste des films</a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Configuration Calendrier Flatpickr
        flatpickr(".date-picker", {
            locale: "fr",
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d F Y"
        });

        // ==========================================================
        // LOGIQUE JAVASCRIPT : PRÉVISUALISATION INFAILLIBLE
        // ==========================================================
        // 1. On cible l'input par son TYPE et non plus par son ID
        const afficheInput = document.querySelector('input[type="file"]');
        const previewBox = document.getElementById('preview-box');
        const previewImg = document.getElementById('affiche-preview-img');

        // On vérifie que le champ existe bien avant d'écouter les changements
        if (afficheInput) {
            afficheInput.addEventListener('change', function(event) {
                const file = event.target.files[0]; 

                if (file && file.type.match('image.*')) {
                    const reader = new FileReader();

                    reader.onload = function(e) {
                        previewImg.src = e.target.result;
                        previewBox.style.display = 'block';
                    }

                    reader.readAsDataURL(file);
                } else {
                    previewBox.style.display = 'none';
                    previewImg.removeAttribute('src'); 
                }
            });
        }
        // ==========================================================
    });
</script>
{% endblock %}