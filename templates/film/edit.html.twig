{% extends 'base.html.twig' %}

{% block title %}Edit Film{% endblock %}

{% block body %}
    <h1>Edit Film</h1>

    {{ include('film/_form.html.twig', {'button_label': 'Update'}) }}

    <a href="{{ path('app_film_index') }}">back to list</a>

    {{ include('film/_delete_form.html.twig') }}
{% endblock %}

{% if film.Affiche %}
    <p>Affiche actuelle :</p>
    <img src="{{ asset('uploads/affiches/' ~ film.Affiche) }}" width="150" alt="Affiche actuelle">
{% endif %}

{{ form_row(form.Affiche) }}
