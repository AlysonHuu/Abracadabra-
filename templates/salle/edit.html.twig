{% extends 'base.html.twig' %}

{% block title %}Modifier la Salle | Abracadabra{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <style>
        .form-card { 
            background: white; 
            border-radius: 15px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.1); 
            max-width: 600px; 
            margin: 40px auto; 
            padding: 40px; 
        }
        
        /* --- Style global pour les champs générés par Symfony --- */
        .form-card div { margin-bottom: 20px; }
        .form-card label { 
            font-weight: bold; 
            color: #333; 
            margin-bottom: 8px; 
            display: block; 
        }
        .form-card input[type="text"], 
        .form-card input[type="number"], 
        .form-card select { 
            width: 100%; 
            padding: 12px; 
            border: 1px solid #ccc; 
            border-radius: 8px; 
            font-family: inherit; 
            font-size: 1rem; 
            transition: 0.3s;
        }
        .form-card input:focus, .form-card select:focus { 
            outline: none; 
            border-color: #8b0000; 
            box-shadow: 0 0 5px rgba(139,0,0,0.3); 
        }
        
        /* --- Boutons d'action --- */
        .btn-update { 
            background: #8b0000; 
            color: white; 
            border: none; 
            padding: 15px; 
            border-radius: 8px; 
            font-weight: bold; 
            cursor: pointer; 
            width: 100%; 
            margin-top: 10px; 
            transition: 0.3s; 
            font-size: 1.1rem; 
        }
        .btn-update:hover { background: #600000; transform: translateY(-2px); }

        /* Style pour le bouton "Delete" natif de Symfony */
        .delete-wrapper { margin-top: 15px; }
        .delete-wrapper button {
            background: transparent;
            color: #d9534f;
            border: 1px solid #d9534f;
            padding: 12px;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: 0.3s;
            font-size: 1rem;
        }
        .delete-wrapper button:hover {
            background: #d9534f;
            color: white;
        }
        
        .back-link { 
            display: block; 
            text-align: center; 
            margin-top: 25px; 
            color: #666; 
            text-decoration: none; 
            font-weight: bold; 
            transition: 0.3s;
        }
        .back-link:hover { color: #8b0000; text-decoration: underline; }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="form-card">
        <h1 style="color: #8b0000; margin-bottom:30px; text-align:center;">
            <i class="fa-solid fa-pen-to-square"></i> Modifier la Salle
        </h1>

        {# Formulaire principal (Mise à jour) #}
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn-update">
                <i class="fa-solid fa-arrows-rotate"></i> Mettre à jour
            </button>
        {{ form_end(form) }}

        {# Formulaire de suppression (Intégré via le fichier _delete_form) #}
        <div class="delete-wrapper">
            {{ include('salle/_delete_form.html.twig') }}
        </div>

        <a href="{{ path('app_salle_index') }}" class="back-link">
            <i class="fa-solid fa-arrow-left"></i> Retour à la liste des salles
        </a>
    </div>
</div>
{% endblock %}