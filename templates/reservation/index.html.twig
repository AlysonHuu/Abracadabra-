{% extends 'base.html.twig' %}

{% block title %}Mes réservations | Abracadabra{% endblock %}

{% block stylesheets %}
<style>
    body { background-color: #ececec; }

    .tickets-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
        gap: 40px; padding: 40px; max-width: 1400px; margin: 0 auto;
    }

    /* --- STYLE DES TICKETS --- */
    .ticket-card {
        background: #f4ecd8; display: flex; height: 220px;
        position: relative; border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        overflow: hidden; border: 1px solid rgba(0,0,0,0.1);
        cursor: pointer; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        transform-style: preserve-3d;
    }

    .ticket-card::before {
        content: ""; position: absolute; top: 0; left: -150%;
        width: 60%; height: 100%;
        background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.6), transparent);
        transform: skewX(-25deg); z-index: 5; pointer-events: none;
    }

    .ticket-card:hover::before { animation: shineSweep 6s infinite; }

    @keyframes shineSweep {
        0% { left: -150%; }
        15% { left: 150%; }
        100% { left: 150%; }
    }

    .aura-JOIE:hover { border-color: #ffd700; box-shadow: 0 10px 30px rgba(255, 215, 0, 0.3); }
    .aura-PEUR:hover { border-color: #8b0000; box-shadow: 0 10px 30px rgba(139, 0, 0, 0.3); }
    .aura-TRISTESSE:hover { border-color: #4682b4; box-shadow: 0 10px 30px rgba(70, 130, 180, 0.3); }
    .aura-NOSTALGIE:hover { border-color: #cd853f; box-shadow: 0 10px 30px rgba(205, 133, 63, 0.3); }
    .aura-MYSTERE:hover { border-color: #4b0082; box-shadow: 0 10px 30px rgba(75, 0, 130, 0.3); }

    .ticket-poster { flex: 0 0 160px; padding: 20px; }
    .ticket-poster img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }
    .ticket-info { flex: 1; padding: 25px; border-left: 2px dashed rgba(0,0,0,0.08); font-family: 'Courier New', monospace; }
    .ticket-film-name { color: #8b0000; font-size: 1.4rem; font-weight: 900; }
    .ticket-qr-section { flex: 0 0 110px; display: flex; align-items: center; justify-content: center; border-left: 2px dashed rgba(0,0,0,0.08); }

    /* --- STYLE DE LA MODALE MAGIQUE (CORRECTION) --- */
    #magic-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.85); backdrop-filter: blur(12px);
        z-index: 9999; display: flex; align-items: center; justify-content: center;
        opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
    }
    #magic-overlay.active { opacity: 1; pointer-events: auto; }

    .magic-modal {
        background: white; width: 90%; max-width: 500px; padding: 40px;
        border-radius: 30px; text-align: center; position: relative;
    }

    .close-magic {
        position: absolute; top: 20px; right: 25px;
        background: none; border: none; font-size: 2rem; color: #ccc; cursor: pointer;
    }

    .large-qr-container {
        position: relative; display: inline-block; padding: 15px;
        background: #fff; border-radius: 20px; border: 1px solid #eee; cursor: pointer; overflow: hidden;
    }
    
    .large-qr-container img { width: 260px; height: 260px; display: block; position: relative; z-index: 1; }

    .scan-line {
        position: absolute; top: 0; left: 0; width: 100%; height: 4px;
        background: #ff0000; box-shadow: 0 0 15px #ff0000; z-index: 10;
        animation: scanAnim 3s infinite ease-in-out;
    }
    
    @keyframes scanAnim { 0% { top: 0%; } 50% { top: 100%; } 100% { top: 0%; } }

    .magic-progress-bar { width: 100%; height: 12px; background: #eee; border-radius: 10px; overflow: hidden; margin: 20px 0; }
    .magic-progress-fill { width: 0%; height: 100%; background: #8b0000; }
</style>
{% endblock %}

{% block body %}
<div class="container">
    <h1 style="color: #8b0000; text-align: center; margin-top: 50px; font-weight: 800; font-size: 2.8rem;">
        <i class="fa-solid fa-receipt"></i> Mes réservations
    </h1>

    <div class="tickets-container">
        {% for res in reservations %}
            {# On utilise res.data pour les données et res.aura pour la classe [cite: 1] #}
            <div class="ticket-card aura-{{ res.aura|default('MYSTERE') }} shine-anim" 
                onclick="openTicket('{{ res.data.ticketToken }}', '{{ res.data.seance.film.nom|escape('js') }}')">
                
                <div class="ticket-poster">
                    <img src="{{ asset('uploads/affiches/' ~ res.data.seance.film.affiche) }}" alt="Affiche">
                </div>
                
                <div class="ticket-info">
                    <div class="ticket-film-name">{{ res.data.seance.film.nom }}</div>
                    <div class="ticket-details">
                        <div><i class="fa-solid fa-calendar"></i> {{ res.data.seance.dateDiffusion|date('d/m/Y') }}</div>
                        <div><i class="fa-solid fa-clock"></i> {{ res.data.seance.dateDiffusion|date('H:i') }}</div>
                        <div style="margin-top: 10px; font-weight: bold; color: #8b0000; text-decoration: underline;">
                            {{ res.data.nbPlaces }} PLACE(S) RÉSERVÉE(S)
                        </div>
                    </div>
                </div>

                <div class="ticket-qr-section">
                    <div style="text-align: center; color: #aaa; font-size: 0.7rem;">
                        <i class="fa-solid fa-qrcode" style="font-size: 2.2rem; display: block; margin-bottom: 5px;"></i>
                        SCAN
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<div id="magic-overlay">
    <div class="magic-modal">
        <button class="close-magic" onclick="closeMagic()">&times;</button>
        
        <div id="step-qr">
            <h2 style="color: #8b0000; margin-bottom: 10px;">Votre Billet Numérique</h2>
            <p style="color: #666; margin-bottom: 25px;">Cliquez sur le QR Code pour valider votre entrée</p>
            <div class="large-qr-container" onclick="startMagicScan()">
                <div class="scan-line"></div>
                {# On affiche le QR code dès le début #}
                <img id="large-qr-img" src="" alt="QR Code">
            </div>
        </div>

        <div id="step-animation" style="display: none;">
             <i class="fa-solid fa-wand-magic-sparkles fa-4x" style="color: #8b0000; margin-bottom: 20px;"></i>
             <h2 id="magic-title">Analyse du profil Jury...</h2>
             <div class="loader-container">
                <div class="magic-progress-bar"><div id="magic-fill" class="magic-progress-fill"></div></div>
                <p id="magic-status" style="font-weight: bold; color: #555;">Initialisation du protocole...</p>
             </div>
             {# QR Code reste visible en filigrane pendant le scan #}
             <div style="opacity: 0.1; transform: scale(0.6); margin-top: -60px;">
                <img id="qr-mini-bg" src="" style="width: 250px;">
             </div>
        </div>

        <div id="step-final" style="display: none;">
            <i class="fa-solid fa-circle-check fa-5x" style="color: #2ecc71; margin-bottom: 20px;"></i>
            <h2 style="color: #333; margin-bottom: 15px;">ACCÈS VIP CONFIRMÉ</h2>
            <p id="final-text" style="font-size: 1.2rem; color: #444; line-height: 1.6;"></p>
            <button class="btn-login" onclick="closeMagic()" style="margin-top: 30px; padding: 12px 30px; background: #8b0000; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">Fermer</button>
        </div>
    </div>
</div>

<script>
let currentFilm = "";
let currentUserName = "{{ app.user.prenom }}";

/**
 * EFFET 3D "HAPPÉ" PAR LA SOURIS
 * Gère l'inclinaison et le léger déplacement du ticket vers le curseur
 */
document.querySelectorAll('.ticket-card').forEach(card => {
    card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        
        // Calcul de la position de la souris à l'intérieur du ticket
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        // Inclinaison calculée (diviseur 12 pour plus de subtilité)
        const rotateX = (y - centerY) / 12;
        const rotateY = (centerX - x) / 12;
        
        // Effet d'attraction (déplacement vers la souris)
        const moveX = (x - centerX) / 15;
        const moveY = (y - centerY) / 15;

        // Application de la transformation 3D
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translate3d(${moveX}px, ${moveY}px, 20px) scale(1.02)`;
    });

    card.addEventListener('mouseleave', () => {
        // Remet le ticket parfaitement à plat quand la souris sort
        card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) translate3d(0, 0, 0) scale(1)`;
    });
});

/**
 * GESTION DE LA MODALE ET DU BILLET
 */
function openTicket(token, filmName) {
    currentFilm = filmName;
    
    // Chargement dynamique du QR Code
    const qrUrl = "/qrcode/" + token;
    document.getElementById('large-qr-img').src = qrUrl;
    document.getElementById('qr-mini-bg').src = qrUrl;
    
    // Réinitialisation des étapes de la modale
    document.getElementById('step-qr').style.display = 'block';
    document.getElementById('step-animation').style.display = 'none';
    document.getElementById('step-final').style.display = 'none';
    
    // Ouverture de l'overlay
    document.getElementById('magic-overlay').classList.add('active');
}

function startMagicScan() {
    document.getElementById('step-qr').style.display = 'none';
    document.getElementById('step-animation').style.display = 'block';
    
    const fill = document.getElementById('magic-fill');
    const status = document.getElementById('magic-status');
    const steps = ["Analyse VIP...", "Calcul jury...", "Pop-corn localisé...", "Magie en cours...", "Accès autorisé !"];
    let stepIndex = 0;

    // Lancement de la barre de progression (6 secondes)
    fill.style.width = "0%";
    setTimeout(() => {
        fill.style.transition = "width 6s linear";
        fill.style.width = "100%";
    }, 50);

    // Changement des messages d'état
    const interval = setInterval(() => {
        if (stepIndex < steps.length) {
            status.innerText = steps[stepIndex];
            stepIndex++;
        } else {
            clearInterval(interval);
            showFinalSuccess();
        }
    }, 1200);
}

function showFinalSuccess() {
    document.getElementById('step-animation').style.display = 'none';
    document.getElementById('step-final').style.display = 'block';
    document.getElementById('final-text').innerHTML = `<strong>Abracadabra !</strong> Vos places pour <em>${currentFilm}</em> sont prêtes pour ${currentUserName}.`;
}

function closeMagic() {
    document.getElementById('magic-overlay').classList.remove('active');
}
</script>
{% endblock %}