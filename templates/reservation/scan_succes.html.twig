{% extends 'base.html.twig' %}

{% block title %}Accès VIP | Abracadabra{% endblock %}

{% block body %}
<style>
    .scan-container {
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), 
                    url('{{ asset('uploads/affiches/' ~ res.seance.film.affiche) }}');
        background-size: cover;
        background-position: center;
        color: white;
        padding: 20px;
    }

    .magic-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(15px);
        padding: 40px;
        border-radius: 30px;
        border: 1px solid rgba(255,255,255,0.2);
        max-width: 500px;
        width: 100%;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }

    .loader-container { margin: 30px 0; }
    
    .progress-bar {
        width: 100%;
        height: 10px;
        background: rgba(255,255,255,0.1);
        border-radius: 5px;
        overflow: hidden;
        position: relative;
    }

    .progress-fill {
        width: 0%;
        height: 100%;
        background: #8b0000;
        animation: fillProgress 4s forwards ease-in-out;
    }

    @keyframes fillProgress {
        0% { width: 0%; }
        30% { width: 45%; }
        60% { width: 70%; }
        100% { width: 100%; }
    }

    .status-text {
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        margin-top: 10px;
        color: #ddd;
    }

    .final-message {
        display: none; /* Caché au début */
        animation: fadeIn 1s forwards;
    }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
</style>

<div class="scan-container">
    <div class="magic-card">
        <h1 style="color: #8b0000; font-weight: 900; letter-spacing: 2px;">ABRACADABRA</h1>
        
        <div id="loading-zone">
            <i class="fa-solid fa-wand-magic-sparkles fa-3x" style="margin-bottom: 20px;"></i>
            <p>Analyse du profil Jury...</p>
            <div class="loader-container">
                <div class="progress-bar"><div class="progress-fill"></div></div>
                <p class="status-text" id="status-label">Initialisation du protocole...</p>
            </div>
        </div>

        <div id="success-zone" class="final-message">
            <i class="fa-solid fa-circle-check fa-4x" style="color: #2ecc71; margin-bottom: 20px;"></i>
            <h2 style="margin-bottom: 15px;">ACCÈS VIP CONFIRMÉ</h2>
            <p style="font-size: 1.1rem; line-height: 1.6;">
                <strong>Abracadabra !</strong> Vos places pour <em>{{ res.seance.film.nom }}</em> se sont transformées en pixels magiques. <br><br>
                L'algorithme a été soudoyé avec succès avec du pop-corn virtuel. Le protocole <strong>"Note Maximale"</strong> est désormais actif.
            </p>
            <div style="margin-top: 30px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 20px;">
                <p>Bonne séance, Cher Membre du Jury !</p>
            </div>
        </div>
    </div>
</div>

<script>
    // Petit script pour changer les textes et afficher le message final
    const statusLabel = document.getElementById('status-label');
    const steps = [
        "Détection de présence VIP...",
        "Calcul de la bienveillance du jury...",
        "Soudoyage de l'algorithme au pop-corn...",
        "Transformation des sièges en pixels...",
        "Accès autorisé !"
    ];

    let step = 0;
    const interval = setInterval(() => {
        if (step < steps.length) {
            statusLabel.innerText = steps[step];
            step++;
        } else {
            clearInterval(interval);
            document.getElementById('loading-zone').style.display = 'none';
            document.getElementById('success-zone').style.display = 'block';
        }
    }, 800);
</script>
{% endblock %}