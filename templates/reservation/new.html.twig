{% extends 'base.html.twig' %}

{% block title %}Réserver - {{ seance.film.nom }}{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 800px; background: white; padding: 40px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
    <div style="display: flex; gap: 40px; flex-wrap: wrap; align-items: center;">
        {# Affiche du film #}
        <div style="flex: 1; min-width: 250px;">
            <img src="{{ asset('uploads/affiches/' ~ seance.film.affiche) }}" 
                 alt="Affiche de {{ seance.film.nom }}" 
                 style="width: 100%; border-radius: 12px; box-shadow: 0 8px 16px rgba(0,0,0,0.2);">
        </div>

        {# Détails et Formulaire #}
        <div style="flex: 1.5; min-width: 300px;">
            <h1 style="color: #8b0000; margin-bottom: 25px; font-weight: 800;">Réserver vos places</h1>
            
            <div style="margin-bottom: 30px; border-left: 5px solid #8b0000; padding-left: 20px; background: #fff8f8; padding-top: 15px; padding-bottom: 15px;">
                <p style="margin-bottom: 8px;"><strong>Film :</strong> {{ seance.film.nom }}</p>
                <p style="margin-bottom: 8px;"><strong>Séance :</strong> Le {{ seance.dateDiffusion|date('d/m/Y') }} à {{ seance.dateDiffusion|date('H:i') }}</p>
                <p style="margin-bottom: 8px;"><strong>Salle :</strong> {{ seance.salle.nom }}</p>
                <p style="margin-bottom: 0;"><strong>Prix :</strong> <span style="color: #8b0000; font-weight: bold; font-size: 1.2rem;">{{ prixUnitaire }} €</span> / place</p>
            </div>

            <form method="post">
                <div class="form-group" style="margin-bottom: 25px;">
                    <label for="nb_places" style="display: block; margin-bottom: 10px; font-weight: bold; color: #555;">Nombre de places :</label>
                    <input type="number" name="nb_places" id="nb_places" class="form-control" min="1" 
                           max="{{ seance.salle.nbPlaces - seance.nbPlaceReservees }}" value="1" required 
                           style="width: 100%; padding: 15px; border: 2px solid #eee; border-radius: 10px; font-size: 1.1rem; font-weight: bold;">
                </div>
                
                <button type="submit" style="width: 100%; padding: 18px; background: #8b0000; color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: bold; font-size: 1.1rem; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px;">
                    <i class="fa-solid fa-credit-card"></i> Procéder au paiement
                </button>
            </form>

            <p style="text-align: center; color: #aaa; font-size: 0.8rem; margin-top: 20px;">
                <i class="fa-solid fa-shield-halved"></i> Paiement 100% sécurisé via Stripe (Mode Test)
            </p>
        </div>
    </div>
</div>
{% endblock %}