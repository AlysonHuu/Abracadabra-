server {
    listen 80;
    server_name abracadabra.local;
    root /var/www/abracadabra/public;

    index index.php index.html;

    # Serve static files directly
    location ~* \.(css|js|jpg|jpeg|gif|png|ico|webp|svg|woff|woff2|ttf|otf|eot|txt|xml|json)$ {
        try_files $uri =404;
    }

    # Redirect everything else to index.php
    location / {
        try_files $uri /index.php$is_args$args;
    }

    # Process PHP files
    location ~ ^/index\.php(/|$) {
        fastcgi_pass php:9000;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
    }

    # Deny access to any other .php files
    location ~ \.php$ {
        return 404;
    }

    error_log /dev/stdout info;
    access_log /var/log/nginx/abracadabra_access.log;
}
